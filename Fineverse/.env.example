# ── Database ────────────────────────────────────────────────────────────
# Point this at a real PostgreSQL instance:
#  - Local: install Postgres and use postgresql://user:pass@localhost:5432/fineverse
#  - Docker: docker run --name fineverse-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
#  - Hosted (free tier): Neon (neon.tech) or Supabase (supabase.com)
DATABASE_URL="postgresql://user:password@localhost:5432/fineverse?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers (leave blank to disable)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Payments (Stripe) ───────────────────────────────────────────────────
# Checkout will show "payment provider not configured" until these are set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Image storage (optional, for admin product image uploads) ─────────
BLOB_READ_WRITE_TOKEN=""

# ── Email (transactional emails: order confirmation, password reset) ───
RESEND_API_KEY=""
EMAIL_FROM="Fineverse <orders@fineverse.example>"

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
